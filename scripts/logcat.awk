{
  # v3.4.70: 修复双引号转义 — 旧实现 gsub(/"/, "\042") 中 \042 就是 " 本身,
  # 等于把引号替换成引号 (空操作), logcat 消息里的双引号从未被转义。
  # 消息含 " 时 JSON 字符串提前结束, 后续 {/} 漏到字符串外被 brace_bal 计数,
  # bal!=0 触发主循环丢弃整个采样 (面板偶发整周期无数据)。
  # 正确: 先转义反斜杠, 再把 " 转成 \"
  gsub(/\\/, "\\\\")
  gsub(/"/, "\\\"")
  if (index($0, "|")) next
  if (match($0, /^[0-9-]+ [0-9:.]+ +[0-9]+ +[0-9]+ +[A-Z] [^:]*:/)) {
    head = substr($0, 1, RLENGTH)
    msg = substr($0, RLENGTH + 1)
    sub(/: *$/, "", head)
    sub(/^ +/, "", msg)
    tag = head
    sub(/^[0-9-]+ [0-9:.]+ +[0-9]+ +[0-9]+ +[A-Z] +/, "", tag)
    printf "{\042tag\042:\042%s\042,\042msg\042:\042%s\042},\n", tag, msg
  }
}